# Disposable local database from: docker compose -f compose.local.yml up -d
DB_HOST=127.0.0.1
DB_USER=mychef_local
DB_PASSWORD=local-development-only
DB_NAME=mychef_local
DB_PORT=23316
API_HOST=127.0.0.1
API_PORT=4000
GOOGLE_MAPS_API_KEY=
# Optional standalone frontend on port 3000. Use the same hostname for both servers.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For a hosted HTTPS deployment, use NODE_ENV=production for Secure cookies.
